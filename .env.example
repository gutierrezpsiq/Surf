# --- Pipeline (GitHub Actions secrets / local shell) ---
SUPABASE_URL=                     # optional: history, calibration, push subscriptions, public storage
SUPABASE_SERVICE_ROLE_KEY=
OPEN_METEO_API_KEY=               # optional commercial key; free tier works without it
STORMGLASS_API_KEY=               # optional, paid aggregator (top 8 seed spots)
WINDY_API_KEY=                    # optional, Windy Point Forecast API
COPERNICUSMARINE_SERVICE_USERNAME= # optional, free Copernicus Marine account
COPERNICUSMARINE_SERVICE_PASSWORD=
OBS_FEEDS=[]                      # buoy feeds for calibration, see pipeline/sources/observations.ts
MARINHA_AVISOS_URL=               # CAP/RSS feed of Marinha warnings, if one becomes available
VAPID_PUBLIC_KEY=                 # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- App build ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_DATA_URL=                    # override where forecast JSON is read from
